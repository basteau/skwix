APP_NAME=Skwix
APP_ENV=e2e
APP_DEBUG=true
APP_URL=http://127.0.0.1:8010
APP_KEY=

APP_LOCALE=nl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=nl_NL

DB_CONNECTION=sqlite
DB_DATABASE=storage/e2e.sqlite

CACHE_STORE=array
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Deterministic AI responses (sequence: yes,no,yes,no,...)
AI_DRIVER=fake
E2E_AI_SEQUENCE=yes,no,yes,no

# Deterministic wheel outcomes (sequence: win,lose,win,lose,...)
FORTUNE_DRIVER=fake
E2E_FORTUNE_SEQUENCE=win,lose,win,lose

# Freeze time (after 8:00 so wordle is available)
E2E_NOW="2026-01-25 09:00:00"

# Disable PWA caching for E2E tests
PWA_ENABLED=false

# Logging
LOG_CHANNEL=single
LOG_LEVEL=debug
