    "phaser": "// Phaser 3 example\nthis.load.spritesheet('player', 'spritesheets/player07.png', {\n  frameWidth: 64,\n  frameHeight: 64\n});\n\n// Create animations\nthis.anims.create({\n  key: 'walk_down',\n  frames: this.anims.generateFrameNumbers('player', { start: 0, end: 3 }),\n  frameRate: 8,\n  repeat: -1\n});",
