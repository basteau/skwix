# ===========================================
# LOCAL DEVELOPMENT
# ===========================================

APP_NAME=Skwix
VITE_APP_NAME="${APP_NAME}"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database (SQLite for local, MySQL/Postgres on Laravel Cloud)
DB_CONNECTION=sqlite

# Simple local drivers (no migrations or workers needed)
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Email (log for dev, resend for production)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@skwix.example"
MAIL_FROM_NAME="${APP_NAME}"

# ===========================================
# API KEYS
# ===========================================

# OpenRouter API for AI question answering
# Get key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5

# AI Driver: 'openrouter' (real API) or 'fake' (for local testing without API key)
# Set to 'fake' for local development without an OpenRouter API key
AI_DRIVER=fake

# Resend for production email delivery
# Get key from https://resend.com/api-keys
RESEND_API_KEY=

# Admin backdoor for /sudo/{token} route
ADMIN_SECRET_TOKEN=

# ===========================================
# OPTIONAL
# ===========================================

# Telegram notifications (chef skill)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Image generation (picasso skill)
# FAL_API_KEY=

# ===========================================
# LARAVEL CLOUD (auto-injected, don't set locally)
# ===========================================
# DB_CONNECTION=mysql
# DB_HOST=
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=
# SESSION_DRIVER=database
# CACHE_STORE=database
# QUEUE_CONNECTION=database
